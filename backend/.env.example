# Copy to backend/.env and edit.

# --- Market: TR (Türkiye, default) | IN (India) | DE (Germany). Switchable in the UI too ---
COUNTRY=TR
# SITE=istanbul | konya  (TR) · amaravati | delhi (IN) · freiburg | berlin (DE)
SITE=istanbul

# --- Real Turkish market data (free account: https://kayit.epias.com.tr/epias-transparency-platform-registration-form)
# Enables the real day-ahead price (PTF) and live grid carbon intensity from the generation mix.
EPIAS_USERNAME=
EPIAS_PASSWORD=

# --- Weather: auto = Open-Meteo live -> NASA POWER -> offline model ---
WEATHER_PROVIDER=auto

# --- Clock: demo = accelerated day from 06:00 today; live = real 15-minute intervals ---
CLOCK_MODE=demo
SECONDS_PER_INTERVAL=4
AUTOSTART=1

# --- Blockchain (leave CHAIN_ENABLED=0 to run fully off-chain) ---
CHAIN_ENABLED=0
# Local:   RPC_URL=http://127.0.0.1:8545  and anvil's first key below
# Amoy:    RPC_URL=https://rpc-amoy.polygon.technology  EXPLORER_URL=https://amoy.polygonscan.com
# Base:    RPC_URL=https://sepolia.base.org             EXPLORER_URL=https://sepolia.basescan.org
RPC_URL=http://127.0.0.1:8545
OPERATOR_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
EXPLORER_URL=

# --- Hugging Face (optional "talk to your agent") ---
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Optional tariff overrides (currency/kWh of the active country). Defaults live in hourgrid/countries.py
# TARIFF_SOLAR=4.38
# TARIFF_PEAK=6.17
# TARIFF_NIGHT=2.94
# TARIFF_FEED_IN=0
# P2P_WHEELING_FEE=0.60
# P2P_TRANSACTION_FEE=0.20
